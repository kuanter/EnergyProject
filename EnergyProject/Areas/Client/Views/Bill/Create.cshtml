@model EnergyProject.ViewModels.BillCreateViewModel
@{
    ViewData["Title"] = "Payment";
}

<link rel="stylesheet" href="~/css/user.css" />

<section class="page">
    <div class="page-header">
        <div>
            <h1 class="h1">Payment</h1>
            <p class="lead">
                After submit we will create a "receipt" row in the <strong>Bills</strong> table linked to the chosen payment account.
            </p>
        </div>
        <div class="page-header-actions">
            <a class="user-btn user-btn-ghost"
               asp-area="Client"
               asp-controller="PaymentAccount"
               asp-action="Show">
                Back to accounts
            </a>
        </div>
    </div>
    <form asp-area="Client"
          asp-controller="Bill"
          asp-action="CreatePost"
          method="post"
          class="form-grid">
        <div class="card mt-24">

            <div asp-validation-summary="All" class="text-danger"></div>

            <input type="hidden" asp-for="PaymentAccountId" />

            <div class="form-row">
                <div class="kpi-card" style="margin-bottom: 20px; border: 1px solid var(--gray-300);">
                    <span class="kpi-label">Amount to Pay</span>
                    <span class="kpi-value" style="color: var(--primary);">@Model.AmountToPay €</span>
                    <span class="kpi-caption">Based on your recent consumption (@Model.Consumption kWh)</span>
                </div>

                <p>
                    <label asp-for="CardDataId" class="form-label">Credit Card</label>
                    <select asp-for="CardDataId" asp-items="Model.CardDataOptions" class="form-control">
                        <option value="">-- Choose Card --</option>
                    </select>
                    <span asp-validation-for="CardDataId" class="text-danger"></span>
                </p>
            </div>

            <div class="form-actions">
                <button type="submit" class="user-btn user-btn-primary">Pay</button>
            </div>
        </div>
    </form>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
