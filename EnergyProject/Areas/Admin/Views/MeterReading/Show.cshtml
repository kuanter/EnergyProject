@using System.Linq
@using System.Globalization
@using EnergyProject.Common.Models
@using EnergyProject.Common.Enums
@using EnergyProject.ViewModels
@model MeterReadingFilterViewModel

@{
    ViewData["Title"] = "Meter Readings";
    var readings      = Model.meterReadings;
    var meterId       = Model.meterId;
    var activeFilter  = Model.dateTimeFilter;
    var sorted        = readings.OrderBy(r => r.CreatedAt).ToList();
    var now           = DateTime.Now;

    List<string> bucketLabels;
    List<string> bucketValues;

    switch (activeFilter)
    {
        case DateTimeFilter.Day:
        {
            var anchor = new DateTime(now.Year, now.Month, now.Day, now.Hour, 0, 0);
            var slots  = Enumerable.Range(0, 24).Select(i => anchor.AddHours(i - 23)).ToList();
            bucketLabels = slots.Select(s => s.ToString("HH:00", CultureInfo.InvariantCulture)).ToList();
            bucketValues = slots.Select(s =>
            {
                var hit = sorted.Where(r => r.CreatedAt >= s && r.CreatedAt < s.AddHours(1)).ToList();
                return hit.Any() ? hit.Last().ValueKWh.ToString(CultureInfo.InvariantCulture) : "null";
            }).ToList();
            break;
        }
        case DateTimeFilter.Month:
        {
            var slots = Enumerable.Range(0, 30).Select(i => now.Date.AddDays(i - 29)).ToList();
            bucketLabels = slots.Select(s => s.ToString("dd.MM", CultureInfo.InvariantCulture)).ToList();
            bucketValues = slots.Select(s =>
            {
                var hit = sorted.Where(r => r.CreatedAt.Date == s).ToList();
                return hit.Any() ? hit.Last().ValueKWh.ToString(CultureInfo.InvariantCulture) : "null";
            }).ToList();
            break;
        }
        case DateTimeFilter.Year:
        {
            var refMonth = new DateTime(now.Year, now.Month, 1);
            var slots    = Enumerable.Range(0, 12).Select(i => refMonth.AddMonths(i - 11)).ToList();
            bucketLabels = slots.Select(s => s.ToString("MM.yyyy", CultureInfo.InvariantCulture)).ToList();
            bucketValues = slots.Select(s =>
            {
                var hit = sorted.Where(r => r.CreatedAt.Year == s.Year && r.CreatedAt.Month == s.Month).ToList();
                return hit.Any() ? hit.Last().ValueKWh.ToString(CultureInfo.InvariantCulture) : "null";
            }).ToList();
            break;
        }
        default:
        {
            bucketLabels = sorted.Select(r => r.CreatedAt.ToString("dd.MM.yyyy HH:mm", CultureInfo.InvariantCulture)).ToList();
            bucketValues = sorted.Select(r => r.ValueKWh.ToString(CultureInfo.InvariantCulture)).ToList();
            break;
        }
    }

    var chartLabelsJson = string.Join(",", bucketLabels.Select(l => $"\"{l}\""));
    var chartValuesJson = string.Join(",", bucketValues);
    var chartFilter     = activeFilter.ToString();
    var lastReading     = sorted.LastOrDefault();
    bool showChart      = activeFilter != DateTimeFilter.All || readings.Count > 0;
}

<link rel="stylesheet" href="~/css/admin-users.css" />
<link rel="stylesheet" href="~/css/meter-reading-chart.css" />

<section class="page">

    <div class="toolbar">
        <div>
            <h1 class="h1">Meter Readings</h1>
            <p class="lead">Live readings for meter <strong>@meterId</strong></p>
        </div>
        <a class="btn" asp-area="Admin" asp-controller="Meter" asp-action="Show">← Back to Meters</a>
    </div>

    <form asp-area="Admin" asp-controller="MeterReading" asp-action="Show" asp-route-id="@meterId" method="post">
        <div style="display:flex; gap:10px; flex-wrap:wrap; align-items:flex-end;">
            <div>
                <label class="form-label" for="dateTimeFilter">Filter</label>
                <select id="dateTimeFilter" name="dateTimeFilter"
                        asp-for="dateTimeFilter" asp-items="Model.DateTimeFilterOptions"
                        class="form-control">
                    <option value="">-- Choose Filter --</option>
                </select>
            </div>
            <button type="submit" class="btn">Refresh</button>
        </div>
    </form>

    @* ── Live stats bar ── *@
    <div class="live-stats" style="margin-top:20px;">
        <div class="live-stat-item">
            <span class="live-stat-label">Status</span>
            <span id="live-status" class="live-status live-status--offline">
                <span id="live-dot" class="live-dot"></span>
                Offline
            </span>
        </div>
        <div class="live-stat-item">
            <span class="live-stat-label">Last value</span>
            <span id="live-last-value" class="live-stat-value">
                @(lastReading != null ? $"{lastReading.ValueKWh:F2} kWh" : "—")
            </span>
        </div>
        <div class="live-stat-item">
            <span class="live-stat-label">Last received</span>
            <span id="live-last-time" class="live-stat-value">
                @(lastReading != null ? lastReading.CreatedAt.ToString("dd.MM.yyyy HH:mm:ss", CultureInfo.InvariantCulture) : "—")
            </span>
        </div>
        <div class="live-stat-item">
            <span class="live-stat-label">Total</span>
            <span class="live-stat-value">@readings.Count readings</span>
        </div>
    </div>

    @* ── Chart ── *@
    @if (showChart)
    {
        <script>
            window.MeterReadingChart = {
                labels: [@Html.Raw(chartLabelsJson)],
                values: [@Html.Raw(chartValuesJson)],
                filter: '@chartFilter'
            };
        </script>

        <div class="chart-card">
            <div class="chart-card-header">
                <div class="chart-card-header-left">
                    <span class="chart-title">Energy Consumption</span>
                    <span class="chart-subtitle">kWh over time · @activeFilter view</span>
                </div>
            </div>
            <div class="chart-wrapper">
                <canvas id="meterReadingChart"></canvas>
            </div>
        </div>
    }

    @* ── Readings table ── *@
    @if (readings.Count > 0)
    {
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Date</th>
                    <th>Value (kWh)</th>
                </tr>
            </thead>
            <tbody id="readings">
                @foreach (var item in readings.OrderByDescending(r => r.CreatedAt))
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.CreatedAt.ToString("dd.MM.yyyy HH:mm:ss", CultureInfo.InvariantCulture)</td>
                        <td><span class="chip chip-dark">@item.ValueKWh kWh</span></td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info text-center" role="alert">
            <h4>No readings in this period</h4>
        </div>
    }

</section>

@* Meter id for JS *@
<span id="meter-id-data" data-meter-id="@meterId" hidden></span>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
<script src="~/js/meter-reading-chart.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/9.0.6/signalr.min.js"></script>
<script src="~/js/meter-live.js"></script>